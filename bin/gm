#!/usr/bin/env bash
# graveyard launcher. Install by symlinking this onto PATH under either name:
#
#   ln -s /path/to/graveyard/bin/gm ~/.local/bin/gm
#   ln -s /path/to/graveyard/bin/gm ~/.local/bin/graveyard
#
# Usage text echoes back whichever name you invoked.
#
# Resolves through the symlink so the repo can live anywhere, including a
# path with spaces in it.
set -euo pipefail

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *)  self=$(dirname "$self")/$target ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd)

GRAVEYARD_INVOKED_AS=$(basename "${BASH_SOURCE[0]}") exec bun run "$root/src/cli.ts" "$@"

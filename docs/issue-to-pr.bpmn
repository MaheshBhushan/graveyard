<bpmn:task id="Reconcile" name="Reconcile record / measure diff"><bpmn:incoming>Flow_Agent_Reconcile</bpmn:incoming><bpmn:outgoing>Flow_Reconcile_Finished</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="Finished" name="Reconciled (done / blocked)"><bpmn:incoming>Flow_Reconcile_Finished</bpmn:incoming></bpmn:endEvent>

<bpmn:process id="IssueToPR" name="graveyard: issue to pull request" isExecutable="false">
<bpmn:documentation>Source: fleet.sqlite; exported: 2026-10-18T21:05:22.963Z; jobs=4; first-launch/no-resume rows=4. Units: milliseconds. p95: nearest rank. Missing/invalid/reversed timestamps excluded. Phase waits are unavailable, never assumed zero. This descriptive model does not execute jobs.</bpmn:documentation>
<bpmn:startEvent id="Issue" name="Issue selected"><bpmn:outgoing>Flow_Issue_Enqueue</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="Enqueue" name="Enqueue issue (gm add)"><bpmn:incoming>Flow_Issue_Enqueue</bpmn:incoming><bpmn:outgoing>Flow_Enqueue_Queue</bpmn:outgoing></bpmn:task>
<bpmn:task id="Queue" name="Wait for WIP slot / dispatch"><bpmn:incoming>Flow_Enqueue_Queue</bpmn:incoming><bpmn:incoming>Flow_Recovery_Queue</bpmn:incoming><bpmn:outgoing>Flow_Queue_Prepare</bpmn:outgoing></bpmn:task>
<bpmn:task id="Prepare" name="Validate config / isolate worktree"><bpmn:incoming>Flow_Queue_Prepare</bpmn:incoming><bpmn:outgoing>Flow_Prepare_Ready</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="Ready" name="Plan ready?"><bpmn:incoming>Flow_Prepare_Ready</bpmn:incoming><bpmn:outgoing>Flow_Ready_Launch</bpmn:outgoing><bpmn:outgoing>Flow_Ready_Blocked</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="Launch" name="Launch detached agent"><bpmn:incoming>Flow_Ready_Launch</bpmn:incoming><bpmn:outgoing>Flow_Launch_Agent</bpmn:outgoing></bpmn:task>
<bpmn:boundaryEvent id="LaunchFailed" name="Launch failed" attachedToRef="Launch" cancelActivity="true"><bpmn:outgoing>Flow_LaunchFailed_Blocked</bpmn:outgoing><bpmn:errorEventDefinition id="Error_LaunchFailed" /></bpmn:boundaryEvent>
<bpmn:subProcess id="Agent" name="Contribution workflow (ferb)"><bpmn:incoming>Flow_Launch_Agent</bpmn:incoming><bpmn:incoming>Flow_Resume_Agent</bpmn:incoming><bpmn:outgoing>Flow_Agent_Reconcile</bpmn:outgoing><bpmn:startEvent id="AgentStart" name="Agent running"><bpmn:outgoing>Flow_AgentStart_Phase0</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="Phase0" name="Assess issue (Phase 0)"><bpmn:incoming>Flow_AgentStart_Phase0</bpmn:incoming><bpmn:outgoing>Flow_Phase0_Go</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="Go" name="GO?"><bpmn:incoming>Flow_Phase0_Go</bpmn:incoming><bpmn:outgoing>Flow_Go_Analyze</bpmn:outgoing><bpmn:outgoing>Flow_Go_Record</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="Analyze" name="Analyze / reproduce"><bpmn:incoming>Flow_Go_Analyze</bpmn:incoming><bpmn:outgoing>Flow_Analyze_Reproduced</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="Reproduced" name="Fix needed?"><bpmn:incoming>Flow_Analyze_Reproduced</bpmn:incoming><bpmn:outgoing>Flow_Reproduced_Fix</bpmn:outgoing><bpmn:outgoing>Flow_Reproduced_Record</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="Fix" name="Implement fix"><bpmn:incoming>Flow_Reproduced_Fix</bpmn:incoming><bpmn:incoming>Flow_TestsPass_Fix</bpmn:incoming><bpmn:incoming>Flow_ReviewPass_Fix</bpmn:incoming><bpmn:outgoing>Flow_Fix_Test</bpmn:outgoing></bpmn:task>
<bpmn:task id="Test" name="Run regression tests"><bpmn:incoming>Flow_Fix_Test</bpmn:incoming><bpmn:outgoing>Flow_Test_TestsPass</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="TestsPass" name="Tests pass?"><bpmn:incoming>Flow_Test_TestsPass</bpmn:incoming><bpmn:outgoing>Flow_TestsPass_Review</bpmn:outgoing><bpmn:outgoing>Flow_TestsPass_Fix</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="Review" name="Adversarial review"><bpmn:incoming>Flow_TestsPass_Review</bpmn:incoming><bpmn:outgoing>Flow_Review_ReviewPass</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="ReviewPass" name="Review passes?"><bpmn:incoming>Flow_Review_ReviewPass</bpmn:incoming><bpmn:outgoing>Flow_ReviewPass_Publish</bpmn:outgoing><bpmn:outgoing>Flow_ReviewPass_Fix</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="Publish" name="Push fork / open PR / comment"><bpmn:incoming>Flow_ReviewPass_Publish</bpmn:incoming><bpmn:outgoing>Flow_Publish_Record</bpmn:outgoing></bpmn:task>
<bpmn:task id="Record" name="Write final run record"><bpmn:incoming>Flow_Go_Record</bpmn:incoming><bpmn:incoming>Flow_Reproduced_Record</bpmn:incoming><bpmn:incoming>Flow_Publish_Record</bpmn:incoming><bpmn:outgoing>Flow_Record_AgentEnd</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="AgentEnd" name="Record written"><bpmn:incoming>Flow_Record_AgentEnd</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_AgentStart_Phase0" sourceRef="AgentStart" targetRef="Phase0" />

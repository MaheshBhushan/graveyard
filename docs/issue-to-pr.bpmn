<bpmn:exclusiveGateway id="Recovery" name="Recovery decision"><bpmn:incoming>Flow_Classify_Recovery</bpmn:incoming><bpmn:outgoing>Flow_Recovery_Park</bpmn:outgoing><bpmn:outgoing>Flow_Recovery_Queue</bpmn:outgoing><bpmn:outgoing>Flow_Recovery_Blocked</bpmn:outgoing></bpmn:exclusiveGateway>

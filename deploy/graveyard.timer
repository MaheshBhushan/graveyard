[Unit]
Description=graveyard tick: keep the fleet topped up from the queue
Documentation=https://github.com/MaheshBhushan/graveyard

[Timer]
# The tick is what makes graveyard a scheduler rather than a one-shot command:
# `dispatch` launches at most --max-jobs per invocation and never restarts a
# finished job's successor on its own, so without a timer the queue stalls the
# moment the first agent exits.
OnBootSec=5min
OnUnitActiveSec=10min
# Every tick starts at most one job (DEFAULT_MAX_JOBS), so the fleet fills to the
# WIP limit gradually rather than launching three paid agents at once.
AccuracySec=1min
Persistent=false

[Install]
WantedBy=timers.target

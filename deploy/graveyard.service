[Unit]
Description=graveyard: work the issue queue with unattended coding agents
Documentation=https://github.com/MaheshBhushan/graveyard
# tmux sessions the agents run in are detached grandchildren; nothing here
# should wait on them or kill them when the supervisor exits.

[Service]
# `gm start --foreground` IS the loop -- it reconciles, fills the free WIP
# slots, sleeps, repeats. That replaces the old oneshot+timer pair, which only
# ever launched on someone else's schedule. Do not enable graveyard.timer
# alongside this: two dispatchers racing the same queue is how you double-spend.
Type=simple
# Agents run inside tmux sessions started by this unit, so they inherit this
# environment. A systemd user unit gets a minimal PATH, and both `claude` and
# the `gm` launcher live in ~/.local/bin -- without this the launch succeeds and
# the agent command is silently not found.
Environment=PATH=/home/maheshk/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/maheshk/.local/bin/gm start --foreground
# SIGTERM to the supervisor stops the loop; already-launched agents finish in
# their own tmux sessions rather than being killed mid-run with tokens spent.
KillMode=process
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
